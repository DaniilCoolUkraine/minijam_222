  objectSprite: {fileID: 21300000, guid: 47b65408418903c40aacea90ff03745c, type: 3}
  questDescription: Bruno the builder here. I'm in a hurry, a big one! I want this
    hammer as fast as possible, ten nails a second. It should be properly sturdy
    and never break, and take less effort per swing.
  requirements:
  - type: 1
    tier: 2
  - type: 4
    tier: 0
  - type: 2
    tier: 3
  successText: Bam bam bam! Ten nails a second and my arm feels great! Fantastic!
  partialText: Okay, it hammers. Nothing special, but fine.
  failureText: Now I hit my own thumb every time! Take it back!
